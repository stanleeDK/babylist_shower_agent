# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# From Google Cloud Console -> Clients -> your "Web application" client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kroger (shopping list): developer.kroger.com app with the Products and Locations APIs.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional
# BASE_URL=http://localhost:8000          # must match the redirect URI registered with Google
# AGENT_EFFORT=low                        # low | medium | high
# DEMO_REPLY_DELAY_SECONDS=10             # seconds before simulated guests and restaurants answer
# DEMO_REPLY_JITTER_SECONDS=2             # plus up to this much, so replies don't land at once

# Production replies via SendGrid Inbound Parse (not needed for demo mode)
# REPLY_DOMAIN=replies.yourdomain.com
# INBOUND_SECRET=long-random-string
